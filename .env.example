# ==============================================================================
# Jewellery Gold Accountability Platform — Environment Variable Configuration
# ==============================================================================
# Copy this file to '.env' at the repository root and customize values for your environment.
# Never commit the actual '.env' file containing real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Credentials & Connection
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=jewellery_gold_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# Spring Boot Datasource (Optional: derived automatically from POSTGRES_* above if omitted)
# SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/jewellery_gold_db
# SPRING_DATASOURCE_USERNAME=postgres
# SPRING_DATASOURCE_PASSWORD=your_postgres_password_here
SPRING_PROFILES_ACTIVE=dev

# ------------------------------------------------------------------------------
# 2. JWT Authentication & Token Security
# ------------------------------------------------------------------------------
# Minimum 256-bit (32-byte) secret. Generate using:
#   Linux/macOS/Git Bash:  openssl rand -base64 32
#   PowerShell:            $b = New-Object byte[] 32; [System.Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
# The backend will safely refuse to start if this variable is missing or under 256 bits.
JWT_SECRET=generate_your_secure_256_bit_jwt_secret_here
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 3. Evaluation Demo Account Passwords
# ------------------------------------------------------------------------------
# Passwords configured here are hashed using BCrypt upon initial startup by DataInitializer.
# They are never overwritten if accounts already exist in your local database.
# Evaluator: Choose your desired test passwords below before running for the first time.
DEMO_FINANCE_PASSWORD=choose_finance_head_password
DEMO_CLERK_PASSWORD=choose_issue_clerk_password
DEMO_KARIGAR_PASSWORD=choose_karigar_password

# ------------------------------------------------------------------------------
# 4. Microservice & Frontend Endpoints
# ------------------------------------------------------------------------------
# AI Slip Extraction Service (FastAPI + Tesseract OCR)
AI_SERVICE_URL=http://localhost:8000
AI_SERVICE_PORT=8000

# Frontend Web Application (Vite proxy / API target)
VITE_API_BASE_URL=http://localhost:8080/api

# ------------------------------------------------------------------------------
# 5. Tesseract OCR (Optional: specify if not in system PATH)
# ------------------------------------------------------------------------------
# Windows default:  C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux default:    /usr/bin/tesseract
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
