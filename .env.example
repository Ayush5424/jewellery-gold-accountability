# Database Credentials
POSTGRES_DB=jewellery_gold_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<your_local_postgres_password>
POSTGRES_PORT=5432

# Evaluation Account Passwords (Loaded on initial user creation; hashed via BCrypt)
DEMO_FINANCE_PASSWORD=<your_finance_head_password>
DEMO_CLERK_PASSWORD=<your_issue_clerk_password>
DEMO_KARIGAR_PASSWORD=<your_karigar_password>

# Spring Profiles & Security
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=<minimum_256_bit_secret_hex_or_base64>
JWT_EXPIRATION_MS=86400000

# Microservice Endpoints
AI_SERVICE_URL=http://localhost:8000
VITE_API_BASE_URL=http://localhost:8080/api
